AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
# Replace these placeholders with your Android SDK and mobilecli device ID.
ANDROID_HOME=/path/to/android-sdk
MOBILE_DEVICE=YOUR_ANDROID_DEVICE_ID
ANDROID_SERIAL=emulator-5554
# Optional patched mobilecli for Android UI cache freshness; see patches/mobilecli/README.md.
# MOBILECLI_PATH=/path/to/patched/mobilecli
