{
  "name": "@olorinm/mobile-mcp-jev",
  "mcpName": "io.github.Olorinm/mobile-mcp-jev",
  "version": "0.0.1",
  "description": "Experimental Mobile MCP fork with Jev Android execution and GLM verification",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olorinm/mobile-mcp-jev.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('lib/index.js', 0o755)\"",
    "start": "node lib/index.js",
    "lint": "eslint .",
    "fixlint": "eslint . --fix",
    "test": "c8 playwright test",
    "test:jev": "playwright test jev.test.ts mobile-device.test.ts format-elements.test.ts server-annotations.test.ts server-batch.test.ts",
    "jev": "node scripts/jev-run.mjs",
    "benchmark:jev": "node scripts/benchmark.mjs",
    "watch": "tsc --watch",
    "clean": "rm -rf lib",
    "prepare": "husky",
    "test:verification": "node scripts/test-verification.mjs"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "7.0.105",
    "ajv": "^8.18.0",
    "commander": "14.0.0",
    "express": "5.1.0",
    "fast-xml-parser": "5.8.0",
    "mobilewright": "0.0.57",
    "qs": "^6.15.0",
    "zod": "^4.1.13",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.49.0",
    "@stylistic/eslint-plugin": "^3.0.1",
    "@types/commander": "^2.12.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.26.1",
    "@typescript-eslint/utils": "^8.26.1",
    "c8": "^10.1.3",
    "eslint": "^9.19.0",
    "eslint-plugin": "^1.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-notice": "^1.0.0",
    "husky": "^9.1.7",
    "typescript": "5.8.2"
  },
  "main": "index.js",
  "bin": {
    "mcp-server-mobile": "lib/index.js"
  },
  "directories": {
    "lib": "lib"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/Olorinm/mobile-mcp-jev/issues"
  },
  "homepage": "https://github.com/Olorinm/mobile-mcp-jev#readme",
  "private": true,
  "x-fork-notice": "Modified from mobile-next/mobile-mcp for the optional Jev executor; see NOTICE."
}
