+	private static void clearAccessibilityCache(UiAutomation automation) {
+		if (Build.VERSION.SDK_INT >= 34 && automation.clearCache()) {
+			return;
+		}
+		// Before API 34, reapplying the same service info clears this connection's
+		// accessibility cache without disconnecting or changing its flags.
+		AccessibilityServiceInfo info = automation.getServiceInfo();
+		if (info == null) {
+			throw new IllegalStateException("Accessibility service is unavailable");
+		}
+		automation.setServiceInfo(info);
+	}
